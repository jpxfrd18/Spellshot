:root {
}

.button {
    background-color: rgba(0, 0, 0, 0.32);
    border-left-color: rgb(255, 235, 4);
    border-right-color: rgb(255, 235, 4);
    border-top-color: rgb(255, 235, 4);
    border-bottom-color: rgb(255, 235, 4);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    color: rgb(255, 238, 51);
    font-size: 100px;
    -unity-text-outline-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    -unity-text-outline-color: rgb(0, 0, 0);
    transition-duration: 100ms;
    transition-timing-function: ease-in;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Jersey20-Regular.ttf?fileID=12800000&guid=dc23da2f6d462c9458857c3c56b55560&type=3#Jersey20-Regular");
}

.button:focus {
    border-left-color: rgb(44, 130, 181);
    border-right-color: rgb(44, 130, 181);
    border-top-color: rgb(44, 130, 181);
    border-bottom-color: rgb(44, 130, 181);
    color: rgb(44, 130, 181);
    translate: 0 -5px;
    transition-duration: 100ms;
    transition-timing-function: ease-in;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Jersey20-Regular.ttf?fileID=12800000&guid=dc23da2f6d462c9458857c3c56b55560&type=3#Jersey20-Regular");
}

.button:hover {
    border-left-color: rgb(44, 130, 181);
    border-right-color: rgb(44, 130, 181);
    border-top-color: rgb(44, 130, 181);
    border-bottom-color: rgb(44, 130, 181);
    color: rgb(44, 130, 181);
    translate: 0 -5px;
    transition-duration: 100ms;
    transition-timing-function: ease-in;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Jersey20-Regular.ttf?fileID=12800000&guid=dc23da2f6d462c9458857c3c56b55560&type=3#Jersey20-Regular");
}

.settingButton {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 238, 51);
    font-size: 90px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    transition-timing-function: ease-in;
    transition-duration: 100ms;
    -unity-text-outline-width: 2px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Inter_28pt-Regular.ttf?fileID=12800000&guid=c902282ef8dd3b7418c4b9cbea85f484&type=3#Inter_28pt-Regular");
}

.settingButton:hover {
    color: rgb(44, 130, 181);
    translate: 0 -5px;
    transition-duration: 100ms;
    transition-timing-function: ease-in;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Inter_28pt-Regular.ttf?fileID=12800000&guid=c902282ef8dd3b7418c4b9cbea85f484&type=3#Inter_28pt-Regular");
}

.settingButton:focus {
    color: rgb(44, 130, 181);
    translate: 0 -5px;
    transition-duration: 100ms;
    transition-timing-function: ease-in;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Inter_28pt-Regular.ttf?fileID=12800000&guid=c902282ef8dd3b7418c4b9cbea85f484&type=3#Inter_28pt-Regular");
}

.settingContainer {
    flex-direction: row;
    align-items: center;
}

.label {
    color: rgb(255, 238, 51);
    font-size: 60px;
    -unity-text-outline-width: 2px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Inter_28pt-Regular.ttf?fileID=12800000&guid=c902282ef8dd3b7418c4b9cbea85f484&type=3#Inter_28pt-Regular");
}

.settingUpdate {
    flex-direction: row;
    -unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Inter_28pt-Regular.ttf?fileID=12800000&guid=c902282ef8dd3b7418c4b9cbea85f484&type=3#Inter_28pt-Regular");
}

.hidden {
    visibility: hidden;
}

.statLabel {
    font-size: 72px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Inter_28pt-Regular.ttf?fileID=12800000&guid=c902282ef8dd3b7418c4b9cbea85f484&type=3#Inter_28pt-Regular");
}

.display {
    font-size: 156px;
    color: rgb(255, 238, 51);
    flex-grow: 0;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Jersey20-Regular.ttf?fileID=12800000&guid=dc23da2f6d462c9458857c3c56b55560&type=3#Jersey20-Regular");
    -unity-text-align: upper-center;
}

.selected {
    color: rgb(140, 195, 227);
    border-left-color: rgb(140, 195, 227);
    border-right-color: rgb(140, 195, 227);
    border-top-color: rgb(140, 195, 227);
    border-bottom-color: rgb(140, 195, 227);
}

.grayscale {
    color: rgb(194, 194, 194);
    border-left-color: rgb(194, 194, 194);
    border-right-color: rgb(194, 194, 194);
    border-top-color: rgb(194, 194, 194);
    border-bottom-color: rgb(194, 194, 194);
}

.grayscale:hover {
    color: rgb(194, 194, 194);
    border-left-color: rgb(194, 194, 194);
    border-right-color: rgb(194, 194, 194);
    border-top-color: rgb(194, 194, 194);
    border-bottom-color: rgb(194, 194, 194);
    translate: 0 0;
}

.grayscale:focus {
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    translate: 0 -5px;
}
