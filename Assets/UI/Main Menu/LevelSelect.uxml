<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/style.uss?fileID=7433441132597879392&amp;guid=f467c54525fb7374a8c95ffba3541e8f&amp;type=3#style"/>
    <ui:VisualElement name="Background" style="flex-grow: 1; color: rgb(0, 0, 0); background-color: rgb(0, 0, 0);">
        <ui:Label text="Select Level" class="display" style="-unity-text-align: upper-center;"/>
        <ui:VisualElement name="Row1" style="flex-direction: row; justify-content: space-around; margin-top: 80px;">
            <ui:Button text="1" name="1" class="button" style="border-left-width: 3px; border-bottom-width: 3px; border-top-width: 3px; border-right-width: 3px; width: 150px; height: 150px;"/>
            <ui:Button text="2" name="2" class="button" style="border-left-width: 3px; border-bottom-width: 3px; border-top-width: 3px; border-right-width: 3px; width: 150px; height: 150px;"/>
            <ui:Button text="3" name="3" class="button" style="border-left-width: 3px; border-bottom-width: 3px; border-top-width: 3px; border-right-width: 3px; width: 150px; height: 150px;"/>
            <ui:Button text="4" name="4" class="button" style="border-left-width: 3px; border-bottom-width: 3px; border-top-width: 3px; border-right-width: 3px; width: 150px; height: 150px;"/>
            <ui:Button text="5" name="5" class="button" style="border-left-width: 3px; border-bottom-width: 3px; border-top-width: 3px; border-right-width: 3px; width: 150px; height: 150px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Row2" style="flex-direction: row; justify-content: space-around; margin-top: 80px;">
            <ui:Button text="6" name="6" class="button" style="border-left-width: 3px; border-bottom-width: 3px; border-top-width: 3px; border-right-width: 3px; width: 150px; height: 150px;"/>
            <ui:Button text="7" name="7" class="button" style="border-left-width: 3px; border-bottom-width: 3px; border-top-width: 3px; border-right-width: 3px; width: 150px; height: 150px;"/>
            <ui:Button text="8" name="8" class="button" style="border-left-width: 3px; border-bottom-width: 3px; border-top-width: 3px; border-right-width: 3px; width: 150px; height: 150px;"/>
            <ui:Button text="9" name="9" class="button" style="border-left-width: 3px; border-bottom-width: 3px; border-top-width: 3px; border-right-width: 3px; width: 150px; height: 150px;"/>
            <ui:Button text="10" name="10" class="button" style="border-left-width: 3px; border-bottom-width: 3px; border-top-width: 3px; border-right-width: 3px; width: 150px; height: 150px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Nav" style="flex-grow: 1; flex-direction: row; justify-content: space-around; padding-top: 180px; padding-right: 0; padding-bottom: 100px; padding-left: 0;">
            <ui:Button text="Back" name="Back" class="button" style="height: 130px;"/>
            <ui:Button text="Next" name="Next" class="button grayscale" style="height: 130px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
