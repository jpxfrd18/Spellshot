                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="DescriptionContainer" style="flex-grow: 1; border-left-color: rgb(255, 235, 4); border-right-color: rgb(255, 235, 4); border-top-color: rgb(255, 235, 4); border-bottom-color: rgb(255, 235, 4); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; margin-right: 50px;">
                <ui:Label text="Placeholder Placeholder Placeholder Placeholder Placeholder Placeholder" name="Subtitle" class="label" style="-unity-text-align: upper-center; white-space: pre-wrap; padding-left: 40px; padding-right: 40px;"/>
                <ui:Label text="Placeholder Placeholder Placeholder Placeholder Placeholder Placeholder Placeholder Placeholder Placeholder Placeholder Placeholder Placeholder" name="Description" class="label" style="white-space: normal; -unity-text-align: upper-left; font-size: 40px; padding-top: 10px; padding-left: 40px; padding-right: 20px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Buttons" style="flex-grow: 0.2; flex-direction: row; justify-content: space-around; padding-bottom: 0; padding-top: 0; margin-bottom: 50px; margin-top: 50px;">
            <ui:Button text="Back" name="Back" class="button"/>
            <ui:Button text="Start" name="Start" class="button"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Popup" style="flex-grow: 1; background-color: rgb(0, 0, 0); position: absolute; left: 25%; top: 25%; border-left-color: rgb(255, 235, 4); border-right-color: rgb(255, 235, 4); border-top-color: rgb(255, 235, 4); border-bottom-color: rgb(255, 235, 4); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; padding-top: 30px; padding-right: 30px; padding-bottom: 30px; padding-left: 30px; display: none;">
        <ui:Label text="You have less than 4 spells selected." name="Warning" class="label"/>
        <ui:Label text="Are you sure you want to continue?" name="Warning2" class="label"/>
        <ui:VisualElement name="Buttons" style="flex-grow: 1; flex-direction: row; justify-content: space-around; margin-top: 20px;">
            <ui:Button text="Back" name="Back2" class="button"/>
            <ui:Button text="Continue" name="Continue" class="button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
