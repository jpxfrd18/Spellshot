                    <ui:VisualElement name="Row2" style="flex-grow: initial; flex-direction: row;">
                        <ui:Button text="LA" name="6" class="button" style="width: 100px; height: 100px; font-size: 50px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
                            <ui:Label text="3" name="6i" style="position: absolute; top: -20px; left: -20px; color: rgba(0, 0, 0, 0.78); background-color: rgb(140, 195, 227); font-size: 20px; -unity-text-outline-width: 0; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; height: 30px; width: 30px;"/>
                        </ui:Button>
                        <ui:Button text="GU" name="7" class="button" style="width: 100px; height: 100px; font-size: 50px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
                            <ui:Label text="4" name="7i" style="position: absolute; top: -20px; left: -20px; color: rgba(0, 0, 0, 0.78); background-color: rgb(140, 195, 227); font-size: 20px; -unity-text-outline-width: 0; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; height: 30px; width: 30px;"/>
                        </ui:Button>
                        <ui:Button text="?" name="8" class="button" style="width: 100px; height: 100px; font-size: 50px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
                            <ui:Label text="1" name="8i" style="position: absolute; top: -20px; left: -20px; color: rgba(0, 0, 0, 0.78); background-color: rgb(140, 195, 227); font-size: 20px; -unity-text-outline-width: 0; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; height: 30px; width: 30px;"/>
                        </ui:Button>
                        <ui:Button text="?" name="9" class="button" style="width: 100px; height: 100px; font-size: 50px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
                            <ui:Label text="1" name="9i" style="position: absolute; top: -20px; left: -20px; color: rgba(0, 0, 0, 0.78); background-color: rgb(140, 195, 227); font-size: 20px; -unity-text-outline-width: 0; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; height: 30px; width: 30px;"/>
                        </ui:Button>
                        <ui:Button text="PO" name="10" class="button" style="width: 100px; height: 100px; font-size: 50px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
                            <ui:Label text="1" name="10i" style="position: absolute; top: -20px; left: -20px; color: rgba(0, 0, 0, 0.78); background-color: rgb(140, 195, 227); font-size: 20px; -unity-text-outline-width: 0; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; height: 30px; width: 30px;"/>
