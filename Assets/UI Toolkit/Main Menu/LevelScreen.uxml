<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/style.uss?fileID=7433441132597879392&amp;guid=f467c54525fb7374a8c95ffba3541e8f&amp;type=3#style"/>
    <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgb(0, 0, 0);">
        <ui:Label text="Placeholder" name="Title" class="display" style="-unity-text-align: upper-center;"/>
        <ui:VisualElement name="Main" style="flex-grow: 1; flex-direction: row; margin-top: 100px;">
            <ui:VisualElement name="SpellButtons" style="flex-grow: initial; padding-left: 100px; padding-top: 0; margin-right: 100px;">
                <ui:Button text="Enchantment" name="Enchantment" class="button grayscale" style="font-size: 50px; height: 100px; margin-bottom: 20px;"/>
                <ui:Label text="Select 4 Incantations" class="label" style="margin-bottom: 4px; -unity-text-align: upper-center; margin-top: 60px;"/>
                <ui:VisualElement name="Grid">
                    <ui:VisualElement name="Row1" style="flex-grow: initial; flex-direction: row;">
                        <ui:Button text="MM" name="1" class="button" style="width: 100px; height: 100px; font-size: 50px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
                            <ui:Label text="1" name="1i" style="position: absolute; top: -20px; left: -20px; color: rgba(0, 0, 0, 0.78); background-color: rgb(140, 195, 227); font-size: 20px; -unity-text-outline-width: 0; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; height: 30px; width: 30px;"/>
                        </ui:Button>
                        <ui:Button text="FB" name="2" class="button" style="width: 100px; height: 100px; font-size: 50px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
                            <ui:Label text="2" name="2i" style="position: absolute; top: -20px; left: -20px; color: rgba(0, 0, 0, 0.78); background-color: rgb(140, 195, 227); font-size: 20px; -unity-text-outline-width: 0; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; height: 30px; width: 30px;"/>
                        </ui:Button>
                        <ui:Button text="FL" name="3" class="button" style="width: 100px; height: 100px; font-size: 50px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
                            <ui:Label text="1" name="3i" style="position: absolute; top: -20px; left: -20px; color: rgba(0, 0, 0, 0.78); background-color: rgb(140, 195, 227); font-size: 20px; -unity-text-outline-width: 0; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; height: 30px; width: 30px;"/>
                        </ui:Button>
                        <ui:Button text="?" name="4" class="button" style="width: 100px; height: 100px; font-size: 50px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
                            <ui:Label text="1" name="4i" style="position: absolute; top: -20px; left: -20px; color: rgba(0, 0, 0, 0.78); background-color: rgb(140, 195, 227); font-size: 20px; -unity-text-outline-width: 0; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; height: 30px; width: 30px;"/>
                        </ui:Button>
                        <ui:Button text="?" name="5" class="button" style="width: 100px; height: 100px; font-size: 50px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
                            <ui:Label text="1" name="5i" style="position: absolute; top: -20px; left: -20px; color: rgba(0, 0, 0, 0.78); background-color: rgb(140, 195, 227); font-size: 20px; -unity-text-outline-width: 0; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; height: 30px; width: 30px;"/>
                        </ui:Button>
