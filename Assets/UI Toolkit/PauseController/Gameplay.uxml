<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/style.uss?fileID=7433441132597879392&amp;guid=f467c54525fb7374a8c95ffba3541e8f&amp;type=3#style"/>
    <ui:VisualElement name="Main" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="UIBars">
            <ui:VisualElement name="HealthContainer" style="padding-left: 0; background-color: rgb(50, 50, 50); height: 24px; width: 400px; padding-top: 0; padding-right: 12px; padding-bottom: 0; margin-top: 35px; margin-left: 30px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(26, 26, 26); border-right-color: rgb(26, 26, 26); border-top-color: rgb(26, 26, 26); border-bottom-color: rgb(26, 26, 26); flex-direction: column;">
                <ui:VisualElement name="HealthBar" style="background-color: rgb(191, 0, 0); flex-grow: 1; flex-direction: row; align-items: flex-end; overflow: hidden;">
                    <ui:VisualElement name="divider" style="width: 80px; height: 80%; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); flex-basis: 100px; position: absolute; left: 0;"/>
                    <ui:VisualElement name="divider" style="width: 80px; height: 80%; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); flex-basis: 100px; position: absolute; left: 80px;"/>
                    <ui:VisualElement name="divider" style="width: 80px; height: 80%; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); flex-basis: 100px; position: absolute; left: 160px;"/>
                    <ui:VisualElement name="divider" style="width: 80px; height: 80%; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); flex-basis: 100px; position: absolute; left: 240px;"/>
                    <ui:VisualElement name="divider" style="width: 80px; height: 80%; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); flex-basis: 100px; position: absolute; left: 320px;"/>
                    <ui:VisualElement name="divider" style="width: 80px; height: 80%; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); flex-basis: 100px; position: absolute; left: 400px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ManaContainer" style="padding-left: 0; padding-top: 0; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-left-color: rgb(26, 26, 26); border-right-color: rgb(26, 26, 26); border-top-color: rgb(26, 26, 26); border-bottom-color: rgb(26, 26, 26); margin-top: 20px; margin-right: 0; margin-bottom: 0; margin-left: 30px; padding-right: 12px; padding-bottom: 0; height: 24px; width: 400px; background-color: rgb(50, 50, 50); overflow: hidden;">
                <ui:VisualElement name="ManaBar" style="background-color: rgb(64, 109, 181); flex-grow: 1; align-items: flex-start; justify-content: flex-end;">
                    <ui:VisualElement name="divider" style="width: 80px; height: 80%; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); flex-basis: 100px; position: absolute;"/>
                    <ui:VisualElement name="divider" style="width: 80px; height: 80%; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); flex-basis: 100px; position: absolute; left: 80px;"/>
                    <ui:VisualElement name="divider" style="width: 80px; height: 80%; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); flex-basis: 100px; position: absolute; left: 160px;"/>
                    <ui:VisualElement name="divider" style="width: 80px; height: 80%; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); flex-basis: 100px; position: absolute; left: 240px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Kill Milita 0/25 OR Kill Munitions 0/2" name="ObjectiveLabel" class="label" style="-unity-text-align: upper-center; padding-left: 100px; padding-top: 50px; flex-grow: 1;"/>
        <ui:Label text="99:99.99" name="Timer" style="-unity-text-align: upper-right; font-size: 100px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; padding-left: 10px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/RobotoMono-Regular.ttf?fileID=12800000&amp;guid=4bf453767847e4f469f128d10468dcb1&amp;type=3#RobotoMono-Regular&quot;); color: rgb(255, 238, 51); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0); flex-grow: 1;"/>
    </ui:VisualElement>
</ui:UXML>
