            <ui:Label text="LA" name="3" class="settingLabel label" style="background-color: rgba(0, 0, 0, 0.98); width: 100px; height: 100px; -unity-text-align: upper-center; padding-top: 20px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; font-size: 40px;"/>
            <ui:Label text="GU" name="4" class="settingLabel label" style="background-color: rgba(0, 0, 0, 0.98); width: 100px; height: 100px; -unity-text-align: upper-center; padding-top: 20px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; font-size: 40px;"/>
