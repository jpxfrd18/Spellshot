            <ui:Label text="E" name="4l" style="-unity-text-align: upper-center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 200px; font-size: 30px; -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px;"/>
